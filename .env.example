# Copy to .env and adjust. docker compose reads this automatically.

# Login credentials for the gateway.
# (The login page shows a fake "minimum 8 characters" hint; the real
#  password can be anything — no length is actually enforced.)
GATEWAY_USER=pdf
GATEWAY_PASS=1

# Session signing secret — CHANGE THIS to a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=please-change-this-secret

# Branding
SITE_TITLE=PDF Studio
