# Copy to .env and adjust. docker compose reads this automatically.

# Login credentials for the gateway.
# (The login page shows a fake "minimum 8 characters" hint; the real
#  password can be anything — no length is actually enforced.)
GATEWAY_USER=pdf
GATEWAY_PASS=1

# Session signing secret — CHANGE THIS to a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=please-change-this-secret

# Branding
SITE_TITLE=PDF Studio

# Cloudflare Tunnel token. The site is reachable ONLY through this tunnel; no
# host ports are opened and no public IP is needed.
# Get it from: Cloudflare Zero Trust > Networks > Tunnels > create tunnel >
# choose "Docker" > copy the token (the long "eyJ..." string).
# Then add a Public Hostname: pdf.snmk.xyz -> HTTP -> gateway:3000
# Lock access to just you: Zero Trust > Access > Applications > allow only
# cninesix@gmail.com (see README).
TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
