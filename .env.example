# Copy to .env and adjust. docker compose reads this automatically.

# Login credentials for the gateway.
# (The login page shows a fake "minimum 8 characters" hint; the real
#  password can be anything — no length is actually enforced.)
GATEWAY_USER=pdf
GATEWAY_PASS=1

# Session signing secret — CHANGE THIS to a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=please-change-this-secret

# Branding
SITE_TITLE=PDF Studio

# Public domain served over HTTPS by Caddy (auto Let's Encrypt certificate).
# DNS: point an A/AAAA record for this name at the host's public IP, and make
# sure ports 80 and 443 reach this host (port-forward if behind NAT).
DOMAIN=pdf.snmk.xyz
# Email used for Let's Encrypt registration / expiry notices (optional).
ACME_EMAIL=cninesix@gmail.com
