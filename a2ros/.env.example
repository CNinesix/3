# ============================================================
# A2 Automation Revenue Operating System — environment config
# Copy to ".env" and fill in real values:  cp .env.example .env
# ============================================================

# --- Core web app ---
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=https://a2.snmk.xyz
# Bind host/port for gunicorn / dev server
APP_HOST=127.0.0.1
APP_PORT=8000
# Timezone used for reports, reminders and scheduling
APP_TIMEZONE=Asia/Kuala_Lumpur
# Set to "production" on the server, "development" locally
APP_ENV=production

# --- Database ---
# SQLite (default, zero-setup):
DATABASE_URL=sqlite:////var/lib/a2ros/a2ros.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://a2ros:secret@localhost:5432/a2ros

# --- Bootstrap admin (created on first `init-db`) ---
ADMIN_EMAIL=admin@a2.snmk.xyz
ADMIN_PASSWORD=ChangeThisAdminPassword123
ADMIN_NAME=A2 Admin

# --- Telegram bot ---
# Get the token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# Get yours from @userinfobot. Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=
# Polling timeout (seconds) for long polling
TELEGRAM_POLL_TIMEOUT=30

# --- Scheduled jobs ---
# Time (24h, HH:MM) in APP_TIMEZONE to send the morning report
DAILY_REPORT_TIME=08:30
# Master switch for proactive alerts (overridable per-setting in dashboard)
ALERTS_ENABLED=true

# --- Optional voice-note transcription ---
# If set, voice notes are transcribed via an OpenAI-compatible audio endpoint.
# Leave blank to disable (voice notes are still saved as untranscribed notes).
TRANSCRIBE_API_BASE=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
